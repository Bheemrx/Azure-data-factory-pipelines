		{
			"name": "[concat(parameters('factoryName'), '/dataflow1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "datasetcopyselected",
								"type": "DatasetReference"
							},
							"name": "sourcedataflowcsv"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "visasinkdataset",
								"type": "DatasetReference"
							},
							"name": "visacustomers"
						},
						{
							"dataset": {
								"referenceName": "mastercardsinkdataset",
								"type": "DatasetReference"
							},
							"name": "mastercardsink"
						},
						{
							"dataset": {
								"referenceName": "americanexpresssinkdataset",
								"type": "DatasetReference"
							},
							"name": "americanexpresssink"
						},
						{
							"dataset": {
								"referenceName": "nopaymentdetailssinkdataset",
								"type": "DatasetReference"
							},
							"name": "nopaymentdetailssink"
						}
					],
					"transformations": [
						{
							"name": "select1"
						},
						{
							"name": "filter1",
							"description": "will filter the cutomer id which is equal to 12"
						},
						{
							"name": "split1"
						},
						{
							"name": "derivedColumn3"
						},
						{
							"name": "split2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          transaction_id as short,",
						"          transactional_date as timestamp,",
						"          product_id as string,",
						"          customer_id as short,",
						"          payment as string,",
						"          credit_card as long,",
						"          loyalty_card as boolean,",
						"          cost as double,",
						"          quantity as short,",
						"          price as double",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> sourcedataflowcsv",
						"sourcedataflowcsv select(mapColumn(",
						"          transaction_id,",
						"          transactional_date,",
						"          product_id,",
						"          customer_id,",
						"          payment,",
						"          credit_card,",
						"          loyalty_card",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 filter(customer_id !=12) ~> filter1",
						"filter1 split(payment=='visa',",
						"     payment=='mastercard',",
						"     disjoint: false) ~> split1@(visa, mastercard, othermethods)",
						"split1@othermethods derive(payment = coalesce(payment,'N/A')) ~> derivedColumn3",
						"derivedColumn3 split(payment=='americanexpress',",
						"     disjoint: false) ~> split2@(payment, nopaymentdetails)",
						"split1@visa sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['visacustomers'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> visacustomers",
						"split1@mastercard sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['mastercardcustomers'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> mastercardsink",
						"split2@payment sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['americanexpresscustomers'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> americanexpresssink",
